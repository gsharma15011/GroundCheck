# GroundCheck Backend Environment Configuration Example
API_PREFIX=/api
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-base
DEVICE=cpu
DENSE_RETRIEVAL_WEIGHT=0.65
LEXICAL_RETRIEVAL_WEIGHT=0.35
MAX_QUERY_CHARS=2000
MAX_RESPONSE_CHARS=20000
DEFAULT_TOP_K=5
MAX_TOP_K=10
MAX_MUTATION_CASES=20
